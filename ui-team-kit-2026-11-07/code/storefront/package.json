{
  "name": "storefront",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate:api": "openapi-typescript ../openapi/v1.yaml -o lib/api/generated/v1.d.ts",
    "check:api": "npm run generate:api && git diff --exit-code -- lib/api/generated/v1.d.ts",
    "scan:bundle": "bash scripts/scan-bundle-for-secrets.sh",
    "e2e": "playwright test",
    "e2e:critical": "playwright test --grep @critical",
    "check:tap-sdk": "node scripts/check-tap-sdk.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "sentry:smoke": "node scripts/sentry-smoke.mjs"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "5.3.0",
    "@sentry/nextjs": "11.9.0",
    "@simplewebauthn/browser": "^13.3.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.5",
    "minimatch": "11.0.3",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.17",
    "@sentry/bundler-plugins": {
      "glob": "14.0.3"
    }
  }
}
